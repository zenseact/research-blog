; Environment config for the standalone viewer, ./build/zdrive_game.
;
; Every [env] key that ocean/zdrive/env_config.h's handler() parses and that
; config/zdrive/zdrive.ini defines, copied verbatim. The viewer's own INI parser
; has no include mechanism, so this is a copy, not an override layer - keep it in
; sync with zdrive.ini. tests/python/test_game_ini.py fails if a key is added
; there and not here.
;
; Values here are free to diverge from training: this file only ever configures
; the viewer. render_mode is not read at all (the viewer forces a pop-up window).

[env]
map_dir = data/binaries

; Options: 0 = discrete, 1 = continuous
action_type = 0
dynamics_model = 0
; Options: "init_all_valid", "init_only_controllable_agents"
init_mode = 0

; Options: "control_vehicles", "control_agents", "control_wosac", "control_sdc_only", "control_mixed_play"
control_mode = 3
max_controlled_agents = 32
init_steps = 0

dt = 0.1

; Episode duration in seconds (converted to steps internally using dt)
episode_duration = 30.1

; Advance to the next scenario after this many episodes (0 = stay on the same
; scenario indefinitely). Set to 1 to cycle through all scenarios.
episodes_per_scenario = 1

; Options: 0 - terminate at episode_duration, 1 - terminate after all agents have been reset
termination_mode = 1

; What to do when the goal is reached. Options: 0:"respawn", 1:"generate_new_goals", 2:"stop", 3: Remove agent
goal_behavior = 3
goal_target_distance = 30.0
goal_radius = 1.5
goal_speed = 100.0

; Options: 0 - Ignore, 1 - Stop, 2 - Remove, 3 - Respawn at original start pos (or nearest navi lane for navi-only agents), 4 - Dynamic mode
collision_behavior = 2

; Rate threshold for dynamic mode (collision). Required > 0 when collision_behavior = 4.
dynamic_behavior_collision_threshold = 0.0

; Options: 0 - Ignore, 1 - Stop, 2 - Remove, 3 - Respawn at original start pos (or nearest navi lane for navi-only agents), 4 - Dynamic mode
offroad_behavior = 0

; Rate threshold for dynamic mode (offroad). Required > 0 when offroad_behavior = 4.
dynamic_behavior_offroad_threshold = 0.0

; Meters the agent must penetrate past a solid lane marker before triggering offroad (0 = immediate)
solid_line_tolerance = 0.0

; Whether crossing solid lane markers counts as offroad (1 = yes, 0 = no)
offroad_solid_lines = 0

; distance threshold where lane offset should be considered offroad
lane_offset_offroad_threshold = 100.0

; Options: 0 - Ignore, 1 - Stop, 2 - Remove, 3 - Respawn at original start pos (or nearest navi lane for navi-only agents)
opposing_lane_behavior = 0

; Options: 0 - Ignore, 1 - Stop, 2 - Remove, 3 - Respawn at original start pos (or nearest navi lane for navi-only agents)
failed_navigation_behavior = 0

; Options: 0 - Respawn (loop from trajectory start), 1 - Continue (extrapolate
; forward at last speed/heading), 2 - Stop (freeze in place), 3 - Remove (invalidate and remove)
end_of_expert_trajectory_behavior = 3

; agents selection mode: 0 = SELECTION_CAPPED, 1 = SELECTION_RANDOMIZED
selection_mode = 0
fraction_rl_agents = 1.0

; Maximum number of respawns per agent per episode when behavior == 3 (Respawn)
max_respawns_per_episode = 3
reward_vehicle_collision = -0.2
reward_offroad_collision = -0.05

; Offroad penalty scaling by the agent's own speed, mirroring collision_rel_speed_*:
; base penalty is 1.0 until |speed| exceeds offroad_speed_high, then grows linearly
; scaled by offroad_speed_scale. Default scale=0.0 keeps the penalty flat (disabled).
offroad_speed_high = 10.0
offroad_speed_scale = 0.0
reward_opposing_lane_weight = -0.05

; Opposing-lane penalty scaling by the agent's own speed, mirroring offroad_speed_*:
; base penalty is 1.0 until |speed| exceeds opposing_lane_speed_high, then grows linearly
; scaled by opposing_lane_speed_scale. Default scale=0.0 keeps the penalty flat (disabled).
opposing_lane_speed_high = 10.0
opposing_lane_speed_scale = 0.0

; heading_diff to the nearest lane must exceed (pi - this) radians to count as driving
; against that lane's direction of travel. Default ~45 deg from directly-opposite.
opposing_lane_heading_threshold = 0.7854
reward_goal = 1.0
reward_goal_post_respawn = 0.25
reward_lane_offset_weight = -0.05
reward_lane_offset_exponent = 1.2
reward_lane_offset_baseline_const = 0.6
reward_over_set_speed_weight = -0.1
reward_over_set_speed_exponent = 2.0
reward_under_set_speed_weight = -0.01
reward_under_set_speed_scale = 1.0
scale_low_priority_collision = 1.0
collision_rel_speed_high = 10.0
collision_rel_speed_scale = 1.0

; Minimum penetration depth (m) required to declare a collision (0 = any overlap).
; Set > 0 to require a minimum overlap before triggering a collision event.
collision_margin = 0.0

; Penetration depth (m) beyond which the near-miss zone begins (must be >= collision_margin).
; Agents within (-collision_threshold, -collision_margin] receive a near-collision penalty.
; 0 = near-miss zone disabled.
collision_threshold = 0.0

; Penalty weight for near-collision events (scaled 0â€“1 by proximity). 0 = disabled.
reward_near_collision = 0.0

; Road-edge distance (m) at/inside which NEAR_OFFROAD_IDX saturates to 1 (the inner edge of the
; near-offroad zone). Does not itself trigger full offroad - that is a separate bounding-box test.
near_offroad_offset_min = 0.0

; Road-edge distance (m) beyond which the near-offroad zone starts (must be >= near_offroad_offset_min).
; Agents with road_edge_dist in [near_offroad_offset_min, near_offroad_offset_max) receive a near-offroad penalty.
; 0 = near-offroad zone disabled.
near_offroad_offset_max = 0.0

; Penalty weight for near-offroad events (scaled 0â€“1 by proximity to a road edge/solid line). 0 = disabled.
reward_near_offroad_weight = 0.0
reward_lane_feasibility_weight = -0.03
reward_road_edge_weight = -0.1
reward_road_edge_threshold = 1.0
reward_lane_alignment_weight = 0
lane_alignment_heading_threshold = 0.2618
reward_max_lane_feasibility = 10.0
reward_toward_goal_weight = 0.02
reward_undertake_weight = -0.3
reward_failed_navigation_weight = -0.1
reward_on_lane_marker_weight = 0.0
reward_lat_acc_weight = -0.0001
reward_lat_acc_exponent = 1.5
reward_long_acc_weight = -0.0001
reward_long_acc_exponent = 1.5
reward_lat_jerk_weight = -0.0001
reward_lat_jerk_exponent = 1.5
reward_long_jerk_weight = -0.0001
reward_long_jerk_exponent = 1.5

; Hinge-squared penalty applied once combined lateral+longitudinal demand goes
; outside the grip envelope, i.e. (a_lat/a_lat_max)^2 + (a_long/a_long_max)^2 > 1.
; Zero inside the envelope. Set weight < 0 to enable; positive weights are rejected.
; Exponent must be > 0 (an exponent of 0 turns the hinge into a step at the boundary).
; The limits match the JERK/HYBRID actuator clamps (MAX_ABS_LAT_ACC, MAX_LONG_ACC,
; MIN_LONG_ACC), so each axis saturated alone sits exactly on the envelope and only
; combined cornering + braking/accelerating is penalised. Higher limits make the term
; unreachable under those dynamics.
reward_friction_ellipse_weight = 0.0
reward_friction_ellipse_exponent = 2.0
reward_friction_ellipse_a_lat_max = 3.0
reward_friction_ellipse_a_long_accel_max = 4.0
reward_friction_ellipse_a_long_brake_max = 4.0
reward_comfort_weight = 0.0

; reward_navi_follow_weight: reward per step for matching navi route curvature.
; Positive value; falls linearly from weight (perfect match) to 0 (error >= norm_curvature).
reward_navi_follow_weight = 0.0
reward_navi_follow_t_lookahead = 1.5

; Curvature tolerance (rad/m): ~0.02 = 1m lateral error / 10m forward, ~0.05 = 2.5m lateral error / 10m forward
reward_navi_follow_norm_curvature = 0.05

; reward_toward_goal_navi_scale: 0 = disabled; 1 = scale reward_toward_goal by navi_follow_ratio (soft coupling).
reward_toward_goal_navi_scale = 0.0
reward_time_alive_weight = 0.0
partner_obs_mask_probability = 0.0
partner_obs_mask_min_samples = 20
partner_obs_mask_max_samples = 30
use_polylines = 0
observe_road_edges = 1

; Cap all agents' current_speed_limit for upcoming curve curvature (v_max derived
; from lateral accel budget). Affects experts' v0/set_speed as well as
; EGO_OBS_SPEED_LIMIT, the render HUD, and the overspeeding KPI for every agent.
use_curve_speed_cap = 0
use_init_jitter = 0
max_init_speed = 36.11

; permute_rl_buffer_slots: default-off chaos-test switch (see its field comment in
; zdrive_types.h) that permutes rl_buffer_slots within each env's own window. Leave 0 in
; shipped configs; flip on locally to exercise the indirection end-to-end.
permute_rl_buffer_slots = 0
use_ego_obs_history = 0
ego_obs_history_size = 0
ego_obs_history_downsampling = 1
ego_obs_history_missing_threshold = 3
use_partner_obs_history = 0
partner_obs_history_size = 0
partner_obs_history_downsampling = 1
partner_obs_history_missing_threshold = 3

; Partner observation noise. Each channel has a near/far amplitude pair.
; Amplitude is linearly interpolated based on ego-to-partner distance:
;   amplitude = near + clamp(distance / far_distance, 0, 1) * (far - near)
; Noise is uniform in [-amplitude, +amplitude], applied to normalized values.
; Set both near and far to 0 to disable noise for a channel.
partner_obs_noise_far_distance = 100.0
partner_obs_noise_speed_near = 0.0
partner_obs_noise_speed_far = 0.0
partner_obs_noise_yaw_rate_near = 0.0
partner_obs_noise_yaw_rate_far = 0.0

; Position noise: absolute additive noise on normalized position.
partner_obs_noise_position_near = 0.0
partner_obs_noise_position_far = 0.0
partner_obs_noise_heading_near = 0.0
partner_obs_noise_heading_far = 0.0
partner_obs_noise_width_near = 0.0
partner_obs_noise_width_far = 0.0
partner_obs_noise_length_near = 0.0
partner_obs_noise_length_far = 0.0

; Ego observation noise: uniform noise amplitude in raw sensor units
; (m/s for speed, radians for steering_angle and a_long/a_lat, metres for lane_feasibility).
; The noise is applied before normalization, so the effective normalized noise is
; noise / normalizer (e.g. noise_speed / MAX_SPEED).
; steering_angle, a_long, a_lat only apply with JERK or HYBRID dynamics model.
; Set to 0 to disable noise for a channel.
ego_obs_noise_speed = 0.0
ego_obs_noise_yaw_rate = 0.0
ego_obs_noise_steering_angle = 0.0
ego_obs_noise_a_long = 0.0
ego_obs_noise_a_lat = 0.0

; Lane feasibility noise is independent of road model noise (zombie path deltas etc).
ego_obs_noise_lane_feasibility = 0.0

; Zombie path delta randomization (seconds).
; At scenario load, each zombie's trajectory is shortened or extended by a random
; delta sampled uniformly in [min, max]. Negative = cut short, positive = extrapolate.
; Extrapolation uses constant speed + constant yaw rate, where the yaw rate is
; the average heading change per sample over the last zombie_path_yaw_window
; seconds of the original trajectory.
; Set both to 0 to disable.
zombie_path_delta_min = 0.0
zombie_path_delta_max = 0.0

; Window (seconds) over which to average the trailing yaw rate from the original
; trajectory. This averaged yaw rate is held constant during extrapolation.
zombie_path_yaw_window = 1.0

; Zombie path lateral offset (constant + two-sinusoid perturbation).
; Applies a smooth lateral wobble to each zombie's trajectory as:
;   offset(t) = const + low_amp * sin(low_freq*t + phase_low) + med_amp * sin(med_freq*t + phase_med)
; The constant offset is sampled per-zombie from [const_min, const_max].
; Amplitudes, frequencies, and phases are sampled per-zombie from uniform distributions.
; The amplitude budget is: med_amp = offset_max - |const| - low_amp.
; Set zombie_path_offset_max = 0 to disable.
zombie_path_offset_max = 0.0
zombie_path_offset_const_min = 0.0
zombie_path_offset_const_max = 0.0
zombie_path_offset_low_amp_max = 0.0

; Frequency parameters are in rad/s (period = 2*pi/freq; defaults give ~8-15 s periods).
zombie_path_offset_low_freq_min = 0.4
zombie_path_offset_low_freq_max = 0.75

; The medium-frequency wave uses med_freq = low_freq * freq_ratio.
zombie_path_offset_freq_ratio = 3.0

; --- Road observation localization drift ---
; Gain: fraction of yaw_rate*dt added as heading drift noise per step
loc_drift_yaw_rate_gain = 0.0

; Gain: fraction of speed*dt added as position drift noise per step
loc_drift_speed_gain = 0.0

; Maximum heading drift (radians)
loc_drift_max_heading = 0.035

; Maximum position drift (meters)
loc_drift_max_position = 0.5

; Probability per step of a localization reset event
loc_reset_probability = 0.005

; After reset, drift is multiplied by uniform(min_retain, max_retain)
loc_reset_min_retain = 0.0
loc_reset_max_retain = 0.3
num_navi_lookahead_waypoints = 50

; Enable blinker (indicator) as a third action head (none=0, left=1, right=2).
; Requires a rebuild with USE_BLINKER_ACTION flag (build.sh reads this automatically).
use_blinker_action = 0

; Requires a rebuild with USE_GOAL_OBSERVATION flag (build.sh reads this automatically).
use_goal_observation = 0

; Requires a rebuild with USE_KAPPA_TARGET flag (build.sh reads this automatically).
use_kappa_target = 1

; Requires a rebuild with USE_LANE_FEASIBILITY_TIME flag (build.sh reads this automatically).
use_lane_feasibility_time = 1

; IDM background traffic parameters (used when control_mode = 5 = CONTROL_IDM_BACKGROUND).
idm_max_accel = 1.5
idm_comfortable_decel = 3.0
idm_min_gap = 2.0
idm_time_headway = 1.5
idm_delta = 4.0
idm_desired_speed_mult = 1.0
